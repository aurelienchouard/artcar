{
  "name": "artcar-studio",
  "version": "6.0.0",
  "private": true,
  "description": "Art Car Studio: a single-file, offline 3D planner for Burning Man art cars",
  "scripts": {
    "build": "python3 build.py",
    "bundle-three": "esbuild src/three-entry.js --bundle --minify --format=iife --outfile=vendor/three-bundle.js",
    "test": "python3 tests/stress.py && python3 tests/func.py"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "0.169.0"
  }
}
